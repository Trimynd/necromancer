# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model names. Swap these once Gemma 4 is generally available;
# these defaults are real models you can call today.
GEMMA_MODEL_HUB=gemma-3-27b-it
GEMMA_MODEL_SPECIALIST=gemma-3-12b-it

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Orchestration limits
MAX_AGENTS=7
MAX_ORCHESTRATION_ROUNDS=3

HOST=0.0.0.0
PORT=8000
