# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model names. Swap these once Gemma 4 is generally available;
# these defaults are real models you can call today.
GEMMA_MODEL_HUB=gemma-4-31b-it
GEMMA_MODEL_SPECIALIST=gemma-4-26b-a4b-it

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Orchestration limits
MAX_AGENTS=5
MAX_BINDER_RETRIES=2

HOST=0.0.0.0
PORT=8000

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional: comma-separated keys from different Google accounts; 429s rotate to the next key
GEMINI_API_KEYS=
